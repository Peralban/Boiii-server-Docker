# Copy this file to ".env" and adjust the values.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
#
# ".env" is git-ignored: it is where your secrets live.

# --- Steam -------------------------------------------------------------------
# The BO3 dedicated server files (app 545990) download anonymously: no Steam
# account and no game ownership required. Leave this as "anonymous".
STEAM_USER=anonymous

# --- Custom client -----------------------------------------------------------
# Which custom client to run: "t7x" or "boiii" (EZZBOIII).
CLIENT=t7x

# --- Server identity ---------------------------------------------------------
SERVER_NAME=BO3 Dedicated Server
SERVER_DESCRIPTION=Private match

# --- Secrets -----------------------------------------------------------------
# Injected into the config files at startup, so no password is ever stored in
# the committed .cfg templates.
#
# Password players need to join. Leave empty for an open server.
SERVER_PASSWORD=
# Remote admin password, used by the built-in RCON terminal.
RCON_PASSWORD=change_me

# --- Gameplay ----------------------------------------------------------------
MAX_PLAYERS=12

# Server port (UDP+TCP). Forward it on your router to play over the internet.
GAME_PORT=27017

# Config file loaded at startup:
#   server.cfg     -> multiplayer
#   server_zm.cfg  -> zombies
#   server_cp.cfg  -> campaign co-op
SERVER_CFG=server.cfg

# Steam Workshop mod id to load (leave empty for none).
MOD_ID=

# Virtual display (1 = enabled). Only needed if the server hangs at startup
# under Wine because it wants a display, even in headless mode.
USE_XVFB=0
